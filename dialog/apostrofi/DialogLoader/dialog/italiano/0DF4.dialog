type: Dialog
bottom:
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "CIAO DI NUOVO! INCOMINCIAMO CON I CONTROLLI DELLA TELECAMERA, SONO SUI PULSANTI C GIALLI." }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "PROVA QUESTO ALLORA, BECCUTA! PREMETE R PER SPOSTARE LA TELECAMERA DIETRO BANJO!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "NO... TENETE PREMUTO R PER MANTENERE LA TELECAMERA DIETRO IL TUO SEDERE PIUMATO! FATE QUALCHE PROVA, CI VEDIAMO ALLA PROSSIMA TANA!" }
  - { cmd: 0x04, string: "" }
top:
  - { cmd: 0x80, string: "EHM... C'E' QUALCUNO IN CASA?" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x81, string: "CASPITA... NON E' NIENTE DI SPECIALE!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x81, string: "TUTTO QUA, ALITO DI VERME?" }
  - { cmd: 0x04, string: "" }
