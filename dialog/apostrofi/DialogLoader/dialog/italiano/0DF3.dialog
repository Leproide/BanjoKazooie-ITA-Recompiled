type: Dialog
bottom:
  - { cmd: 0x83, string: "ASCOLTATEMI! SONO BOTTLES, LA TALPA MIOPE." }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "E' SENZA DUBBIO UN'AMICA DALL'ASPETTO UN PO' BIZZARRO, BANJO. SA PARLARE?" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "LA BRUTTA STREGA GRUNTILDA E' PIOMBATA GIU' DAL CIELO E L'HA RAPITA!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "E' VOLATA VERSO IL SUO ANTRO SULLA MONTAGNA!" }
  - { cmd: 0x07, string: "" }
  - { cmd: 0x83, string: "E' MOLTO PERICOLOSO, PERCIO' AVRETE BISOGNO DI UN PO' DI ALLENAMENTO PRIMA DI ANDARE FIN LASSU'." }
  - { cmd: 0x07, string: "" }
  - { cmd: 0x02, string: "" }
top:
  - { cmd: 0x06, string: "" }
  - { cmd: 0x80, string: "IO SONO BANJO, E QUESTA E' LA MIA AMICA KAZOOIE." }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x81, string: "MEGLIO DI TE SENZ'ALTRO, QUATTROCCHI!" }
  - { cmd: 0x80, string: "COS'ERA TUTTO QUEL CHIASSO? DOV'E' MIA SORELLA TOOTY?" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x81, string: "STAI CALMO, TONTOLONE, LA SALVEREMO! DA CHE PARTE E' ANDATA LA STREGA?" }
  - { cmd: 0x02, string: "" }
