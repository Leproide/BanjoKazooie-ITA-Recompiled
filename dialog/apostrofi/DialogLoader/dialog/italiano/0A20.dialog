type: Dialog
bottom:
  - { cmd: 0x83, string: "E' LA TUA GRANDE OCCASIONE, ZAMPE DI GALLINA. E' ORA CHE TU IMPARI A VOLARE!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "E' ABBASTANZA SEMPLICE ANCHE PER TE, TESTA DI QUAGLIA. BASTA RESTARE SU UNA PEDANA DI VOLO E PREMERE A." }
  - { cmd: 0x83, string: "ECCO A TE 25 PIUME ROSSE PER AIUTARTI A VOLARE!" }
  - { cmd: 0x07, string: "" }
  - { cmd: 0x83, string: "CI VEDIAMO!" }
  - { cmd: 0x02, string: "" }
top:
