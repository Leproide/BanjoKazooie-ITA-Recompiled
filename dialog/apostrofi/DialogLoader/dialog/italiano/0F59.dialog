type: Dialog
bottom:
  - { cmd: 0x83, string: "PER ACCEDERE AL MONDO MOSTRATO NEL QUADRO, DOVETE TAPPARE GLI SPAZI MANCANTI CON I PEZZI DI PUZZLE." }
