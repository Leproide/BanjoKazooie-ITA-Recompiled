type: Dialog
bottom:
  - { cmd: 0x83, string: "EHI! DOVE STATE ANDANDO, RAGAZZI?" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "NON AVETE ANCORA IMPARATO LE BASI, VI PRENDERA' A CALCI NEL SEDERE!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "IL PONTE E' ROTTO E NON LO RIPARERO' FINCHE' NON AVRETE IMPARATO TUTTE LE MOSSE NECESSARIE." }
  - { cmd: 0x04, string: "" }
top:
  - { cmd: 0x06, string: "" }
  - { cmd: 0x80, string: "STIAMO ANDANDO A PICCHIARE LA STREGA E A SALVARE TOOTY!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x81, string: "CHE PROVI PURE, LA VECCHIACCIA!" }
  - { cmd: 0x06, string: "" }
  - { cmd: 0x80, string: "FORZA, KAZOOIE, ANDIAMO A CERCARE QUELLE CHE CI SIAMO PERSI..." }
  - { cmd: 0x04, string: "" }
