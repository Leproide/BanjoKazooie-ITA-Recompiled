  - { cmd: 0x06, string: "" }
  - { cmd: 0x83, string: "IL CERVELLO DI GALLINA PUO' TRASPORTARE 100 UOVA NEL SUO ZAINO. OH... E PUOI ANCHE USARE LA LEVETTA ANALOGICA PER PRENDERE LA MIRA MENTRE SEI ACCOVACCIATA. FAVUOVOLOSO, EH?" }
  - { cmd: 0x83, string: "ORA CHE HAI IMPARATO COME USARE LE UOVA, ECCOTENE 50 PER ALLENARTI!" }
