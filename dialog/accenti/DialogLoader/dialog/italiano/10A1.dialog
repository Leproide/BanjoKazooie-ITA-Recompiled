type: Dialog
bottom:
  - { cmd: 0xCB, string: "CIAO, GIOVANOTTI! SONO BRENTILDA, LA SORELLA GENTILE DI GRUNTILDA. MI SONO INTRUFOLATA QUI PER AIUTARVI A SCONFIGGERE LA VECCHIA STREGA, È ORA CHE QUALCUNO LE DIA UNA LEZIONE!" }
  - { cmd: 0xCB, string: "CONOSCO TUTTI I DISGUSTOSI SEGRETI DI GRUNTY, E VE NE DIRÒ TRE OGNI VOLTA CHE MI TROVERETE." }
  - { cmd: 0xCB, string: "RICORDATELI BENE, GIOVANOTTI, IN QUANTO VI AIUTERANNO AD EVITARE UN DESTINO FIAMMEGGIANTE!" }
  - { cmd: 0xCB, string: "PREMETE B SE AVETE VOGLIA DI ASCOLTARLI!" }
  - { cmd: 0x04, string: "" }
top:
  - { cmd: 0x04, string: "" }
