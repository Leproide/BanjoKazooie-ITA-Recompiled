type: Dialog
bottom:
  - { cmd: 0x87, string: "EHILÀ DALLA NAVE! SONO CAPITAN BLUBBER, E HO PERSO IL MIO TESORO QUANDO LA MIA NAVE SI È SCHIANTATA." }
